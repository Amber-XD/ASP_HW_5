
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Game Library</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/Game/Index" class="logo">Game Library</a>

            <nav>
                <a href="/Game/Index">All Games</a>
                <a href="/Game/Completed">Completed</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>Game Library &copy; 2026</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
